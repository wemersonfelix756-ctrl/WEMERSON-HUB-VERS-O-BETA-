-- ================= ESP =================
local Highlights = {}

local function GetRoles()
    local success, data = pcall(function()
        return ReplicatedStorage:FindFirstChild("GetPlayerData", true):InvokeServer()
    end)
    if success and data then
        return data
    end
    return {}
end

local function ClearHighlights()
    for _, h in pairs(Highlights) do
        if h and h.Parent then
            h:Destroy()
        end
    end
    table.clear(Highlights)
end

local function UpdateESP()
    if not ESP_ENABLED then
        ClearHighlights()
        return
    end

    local roles = GetRoles()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr \~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local roleData = roles[plr.Name]
            local role = roleData and roleData.Role or "Innocent"

            local color = Color3.fromRGB(0, 255, 0) -- Innocent
            if role == "Murderer" then
                color = Color3.fromRGB(255, 0, 0)
            elseif role == "Sheriff" then
                color = Color3.fromRGB(0, 120, 255)
            end

            local highlight = Highlights[plr]
            if not highlight or not highlight.Parent then
                highlight = Instance.new("Highlight")
                highlight.Parent = plr.Character
                Highlights[plr] = highlight
            end

            highlight.FillColor = color
            highlight.OutlineColor = color
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end
    end
end

-- ================= AUTO GRAB GUN =================
local function AutoGrabGun()
    if not AUTO_GRAB_GUN then return end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GunDrop" or (obj:IsA("Tool") and string.find(string.lower(obj.Name), "gun")) then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
            if handle then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = handle.CFrame
                    task.wait(0.12)
                end
            end
        end
    end
end

-- ================= TARGET FINDER =================
local function GetClosestEnemy(range)
    local closest, dist = nil, range or math.huge
    local roles = GetRoles()
    local myData = roles[LocalPlayer.Name]
    local myRole = myData and myData.Role

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr \~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local roleData = roles[plr.Name]
            local theirRole = roleData and roleData.Role

            local isTarget = false
            if myRole == "Sheriff" and theirRole == "Murderer" then
                isTarget = true
            elseif myRole == "Murderer" and theirRole \~= "Murderer" then
                isTarget = true
            end

            if isTarget then
                local d = (plr.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = plr
                end
            end
        end
    end
    return closest
end

-- ================= COIN FARM =================
local function CoinFarm()
    if not COIN_FARM then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, coin in ipairs(workspace:GetDescendants()) do
        if coin.Name == "Coin" or string.find(string.lower(coin.Name), "coin") then
            if coin:IsA("BasePart") or coin:FindFirstChildWhichIsA("BasePart") then
                local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
                hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.15)
                break
            end
        end
    end
end

-- ================= MAIN LOOP =================
RunService.RenderStepped:Connect(function()
