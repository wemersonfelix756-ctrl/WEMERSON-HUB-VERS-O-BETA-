-- ================= FUNÇÕES =================
local function IsAlive(plr)
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function FlingToVoid(target)
    if not target or not target.Character then return end
    local root = target.Character:FindFirstChild("HumanoidRootPart")
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not myRoot then return end

    -- Método clássico de fling (alto angular + velocidade)
    local bv = Instance.new("BodyAngularVelocity")
    bv.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bv.AngularVelocity = Vector3.new(0, 99999, 0)
    bv.Parent = myRoot

    local bv2 = Instance.new("BodyVelocity")
    bv2.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv2.Velocity = Vector3.new(0, -99999, 0) -- joga pra baixo (void)
    bv2.Parent = myRoot

    -- Fica colado no alvo por um tempo
    local start = tick()
    while tick() - start < 1.5 and target.Character and target.Character:FindFirstChild("HumanoidRootPart") do
        myRoot.CFrame = target.Character.HumanoidRootPart.CFrame
        RunService.Heartbeat:Wait()
    end

    bv:Destroy()
    bv2:Destroy()
end

-- ================= MAIN LOOPS =================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.WalkSpeed = WALK_SPEED
    end

    UpdateESP()

    if AUTO_GRAB_GUN then
        AutoGrabGun()
    end

    if COIN_FARM and hrp then
        -- Tween suave até a moeda mais próxima
        local nearest, nearestDist = nil, math.huge
        for _, coin in ipairs(workspace:GetDescendants()) do
            if (coin.Name == "Coin" or string.find(string.lower(coin.Name), "coin")) then
                local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
                if part then
                    local d = (part.Position - hrp.Position).Magnitude
                    if d < nearestDist then
                        nearestDist = d
                        nearest = part
                    end
                end
            end
        end

        if nearest and nearestDist > 3 then
            local distance = (nearest.Position - hrp.Position).Magnitude
            local tweenTime = math.clamp(distance / COIN_TWEEN_SPEED, 0.1, 3)
            local tween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Linear), {
                CFrame = CFrame.new(nearest.Position + Vector3.new(0, 3, 0))
            })
            tween:Play()
        end
    end
end)

-- Hitbox Expander
RunService.Stepped:Connect(function()
    if HITBOX_EXPAND then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr \~= LocalPlayer and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    if not originalHitboxes[root] then
                        originalHitboxes[root] = root.Size
                    end
                    root.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
                    root.Transparency = 0.7
                    root.CanCollide = false
                end
            end
        end
    end
end)

-- Void Fling (quando ativa e encosta)
local flinging = false
RunService.Stepped:Connect(function()
    if VOID_FLING and not flinging and LocalPlayer.Character then
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr \~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (plr.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < 5 then
                    flinging = true
                    FlingToVoid(plr)
                    task.wait(2)
                    flinging = false
                    break
                end
            end
        end
    end
end)

